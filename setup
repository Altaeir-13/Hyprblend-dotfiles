#!/usr/bin/env bash
cd "$(dirname "$0")"
# Use REPO_ROOT instead of base - when scripts are sourced they do not need export to inherit vars
REPO_ROOT="$(pwd)"
source ./sdata/lib/environment-variables.sh
source ./sdata/lib/functions.sh
source ./sdata/lib/package-installers.sh
source ./sdata/lib/dist-determine.sh

prevent_sudo_or_root
set -e

#####################################################################################
showhelp_global(){
printf "${STY_CYAN}NOTE:
  The old \"./install.sh\"   is now \"./setup install\"
  The old \"./update.sh\"    is now \"./setup exp-update\"
  The old \"./uninstall.sh\" is now \"./setup uninstall\"${STY_RST}

[$0]: Handle setup for illogical-impulse.

Syntax:
  $0 <subcommand> [OPTIONS]...

Subcommands:
  install        (Re)Install/Update illogical-impulse.
                 Note: To update to the latest, manually run \"git stash && git pull\" first.
  install-deps   Run the install step \"1. Install dependencies\"
  install-setups Run the install step \"2. Setup for permissions/services etc\"
  install-files  Run the install step \"3. Copying config files\"
  resetfirstrun  Reset firstrun state.
  uninstall      Uninstall illogical-impulse.

  exp-update     (Experimental) Update illogical-impulse without fully reinstall.
  exp-merge      (Experimental) Merge upstream changes with local configs using git rebase.

  virtmon        (For dev only) Create virtual monitors for testing multi-monitors.
  checkdeps      (For dev only) Check whether pkgs exist in AUR or repos of Arch.

  help           Show this help message.

For each <subcommand>, use -h for details:
  $0 <subcommand> -h

${STY_BOLD}${STY_CYAN}Access ${STY_UNDERLINE}https://ii.clsty.link${STY_RST} ${STY_BOLD}${STY_CYAN}for documentation about illogical-impulse.${STY_RST}
"
}
case $1 in
  # Global help
  ""|help|--help|-h)showhelp_global;exit;;
  # Correct subcommand
  install|uninstall|exp-update|exp-merge|resetfirstrun|checkdeps|virtmon)
    SUBCMD_NAME=$1
    SUBCMD_DIR=./sdata/subcmd-$1
    shift;;
  # Correct subcommand but not using ./sdata/subcmd-$1
  install-deps|install-setups|install-files)
    SUBCMD_NAME=$1
    SUBCMD_DIR=./sdata/subcmd-install
    shift;;
  # Wrong subcommand
  *)printf "${STY_RED}Unknown subcommand \"$1\".${STY_RST}\n";showhelp_global;exit 1;;
esac
#####################################################################################
if [[ -f "${SUBCMD_DIR}/options.sh" ]];
  then source "${SUBCMD_DIR}/options.sh"
fi

# Hyprland Hybrid Rice: distribution verification and consent guard
# Protects all subcommands modifying system packages, permissions, configs, dotfiles, or state
case ${SUBCMD_NAME} in
  install|install-deps|install-setups|install-files|uninstall|exp-update|exp-merge|resetfirstrun)
    for function in ${print_os_group_id_functions[@]}; do
      $function
    done
    pause
    if [[ "${CLEAN_CACHE:-false}" == "true" ]]; then
      cleancache
    fi
    ;;
esac

verify_post_install_caelestia() {
  if [[ "${INSTALL_CAELESTIA_HYBRID:-false}" != "true" ]]; then
    log_event "Perfil ${INSTALL_PROFILE}: Caelestia não habilitado. end-4 mantido como frontend exclusivo."
    return 0
  fi

  echo -e "\n${STY_CYAN}[setup]: Verificação pós-instalação do Caelestia Hybrid (redshift-doctor)...${STY_RST}"

  local doctor_cmd="${XDG_BIN_HOME:-$HOME/.local/bin}/redshift-doctor"
  if [[ ! -x "$doctor_cmd" ]] && [[ -x "dots/.local/bin/redshift-doctor" ]]; then
    doctor_cmd="dots/.local/bin/redshift-doctor"
  fi

  local doctor_ok=false
  if [[ -x "$doctor_cmd" ]]; then
    if "$doctor_cmd" --check caelestia >/dev/null 2>&1; then
      doctor_ok=true
    fi
  else
    local cand
    for cand in "${CAELESTIA_QML_PATH:-}" "/usr/lib/qt6/qml" "/usr/local/lib/qt6/qml" "${XDG_DATA_HOME:-$HOME/.local/share}/quickshell/qml" "$HOME/.local/lib/qt6/qml"; do
      if [[ -n "$cand" ]] && [[ -f "$cand/Caelestia/qmldir" ]] && find "$cand/Caelestia" -type f -name "*.so*" 2>/dev/null | grep -q .; then
        doctor_ok=true
        break
      fi
    done
  fi

  if [[ "$doctor_ok" == "true" ]]; then
    log_event "Pós-instalação: Caelestia Hybrid e plugin nativo validados com sucesso."
    echo -e "${STY_GREEN}[OK] Caelestia Hybrid e plugin nativo validados com sucesso!${STY_RST}"
    echo -e "${STY_GREEN}     Alternância entre end-4 e Caelestia pronta via ui-switch.sh.${STY_RST}"
  else
    log_event "AVISO Pós-instalação: Plugin Caelestia ausente ou quebrado. Configuração híbrida mantida em fallback para end-4."
    echo -e "${STY_YELLOW}[AVISO] O módulo Caelestia não foi detectado ou possui dependências pendentes.${STY_RST}"
    echo -e "${STY_YELLOW}       O sistema utilizará end-4 como frontend estável.${STY_RST}"
    echo -e "${STY_YELLOW}       Para diagnosticar e reparar, execute: redshift-doctor --check caelestia${STY_RST}"
    if [[ "${DRY_RUN:-false}" != "true" ]]; then
      mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/quickshell/ui-switch"
      printf 'end4\n' > "${XDG_STATE_HOME:-$HOME/.local/state}/quickshell/ui-switch/current"
    fi
  fi
}

case ${SUBCMD_NAME} in
  install)
    init_install_log
    check_install_prerequisites
    load_install_profile "${INSTALL_PROFILE}"
    # Initialize sudo keepalive for the entire install process
    sudo_init_keepalive
    # Set trap to cleanup when this subcommand exits
    trap sudo_stop_keepalive EXIT INT TERM
    if [[ "${SKIP_ALLGREETING}" != true ]]; then
      source ${SUBCMD_DIR}/0.greeting.sh
    fi
    load_install_profile "${INSTALL_PROFILE}"
    if [[ "${SKIP_ALLDEPS}" != true ]]; then
      source ${SUBCMD_DIR}/1.deps-router.sh
    fi
    if [[ "${SKIP_ALLSETUPS}" != true ]]; then
      source ${SUBCMD_DIR}/2.setups.sh
    fi
    if [[ "${SKIP_ALLFILES}" != true ]]; then
      source ${SUBCMD_DIR}/3.files.sh
    fi
    verify_post_install_caelestia
    ;;
  install-deps)
    init_install_log
    check_install_prerequisites
    load_install_profile "${INSTALL_PROFILE}"
    # Initialize sudo keepalive for dependency installation
    sudo_init_keepalive
    # Set trap to cleanup when this subcommand exits
    trap sudo_stop_keepalive EXIT INT TERM
    if [[ "${SKIP_ALLDEPS}" != true ]]; then
      source ${SUBCMD_DIR}/1.deps-router.sh
    fi
    ;;
  install-setups)
    init_install_log
    check_install_prerequisites
    load_install_profile "${INSTALL_PROFILE}"
    # Initialize sudo keepalive for setup steps
    sudo_init_keepalive
    # Set trap to cleanup when this subcommand exits
    trap sudo_stop_keepalive EXIT INT TERM
    if [[ "${SKIP_ALLSETUPS}" != true ]]; then
      source ${SUBCMD_DIR}/2.setups.sh
    fi
    ;;
  install-files)
    init_install_log
    check_install_prerequisites
    load_install_profile "${INSTALL_PROFILE}"
    if [[ "${SKIP_ALLFILES}" != true ]]; then
      source ${SUBCMD_DIR}/3.files.sh
    fi
    verify_post_install_caelestia
    ;;
  *)
    source ${SUBCMD_DIR}/0.run.sh
    exit
    ;;
esac
