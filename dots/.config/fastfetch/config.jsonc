{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "~/.config/fastfetch/redshift_logo.txt",
        "padding": {
            "top": 0,
            "right": 4,
            "left": 0
        }
    },
    "display": {
        "separator": ": "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "format": "Redshift OS {arch}"
        },
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "battery",
        "poweradapter",
        "locale",
        "break",
        "colors"
    ]
}
